# 储存下载文件的路径，按需修改
MEDIA_DIR=/mnt/share/data
# Qbittorrent 做种端口
QB_TORRENTING_PORT=40278
# Transmission 做种端口
TR_TORRENTING_PORT=40865
# Transmission 用户名
TR_USER=admin
# Transmission 密码
TR_PASS=admin
# 取消下面一行注释以自定义 Transmission 的 WEBUI，路径应为映射到容器内的路径
# TRANSMISSION_WEB_HOME=/config/transmissionic
PUID=1000
PGID=1000
TZ=Asia/Shanghai
